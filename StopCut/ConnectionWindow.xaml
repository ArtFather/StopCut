<Window x:Class="StopCut.ConnectionWindow" Icon="/Assets/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TigerStop connection" Height="620" Width="900" WindowStartupLocation="CenterOwner">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Width="340">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Port" />
                            <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,4">
                                <Button DockPanel.Dock="Right" Content="Refresh" Margin="6,0,0,0" Command="{Binding RefreshPortsCommand}" />
                                <ComboBox ItemsSource="{Binding Ports}" SelectedItem="{Binding Serial.PortName}" />
                            </DockPanel>

                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Baud rate" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4" ItemsSource="{Binding BaudRates}" SelectedItem="{Binding Serial.BaudRate}" />

                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Data bits" />
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" Text="{Binding Serial.DataBits}" />

                            <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Parity" />
                            <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,4" ItemsSource="{Binding ParityOptions}" SelectedItem="{Binding Serial.Parity}" />

                            <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="Stop bits" />
                            <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,4" ItemsSource="{Binding StopBitsOptions}" SelectedItem="{Binding Serial.StopBits}" />

                            <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="Handshake" />
                            <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,4" ItemsSource="{Binding HandshakeOptions}" SelectedItem="{Binding Serial.Handshake}" />

                            <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="Move command" ToolTip="{}{pos} is replaced with the position" />
                            <TextBox Grid.Row="6" Grid.Column="1" Margin="0,4" Text="{Binding Serial.MoveCommandTemplate}" ToolTip="{}{pos} is replaced with the position" />

                            <TextBlock Grid.Row="7" Style="{StaticResource FieldLabel}" Text="Line ending" />
                            <TextBox Grid.Row="7" Grid.Column="1" Margin="0,4" Text="{Binding Serial.Terminator}" ToolTip="Use \r, \n or \r\n" />

                            <TextBlock Grid.Row="8" Style="{StaticResource FieldLabel}" Text="Decimals" />
                            <TextBox Grid.Row="8" Grid.Column="1" Margin="0,4" Text="{Binding Serial.Decimals}" />

                            <TextBlock Grid.Row="11" Style="{StaticResource FieldLabel}" Text="Char delay (ms)" />
                            <TextBox Grid.Row="11" Grid.Column="1" Margin="0,4" Text="{Binding Serial.CharDelayMs}"
                                     ToolTip="Pause after each character sent. Reconnect after changing it." />

                            <TextBlock Grid.Row="10" Style="{StaticResource FieldLabel}" Text="Machine units" />
                            <ComboBox Grid.Row="10" Grid.Column="1" Margin="0,4" ItemsSource="{Binding UnitOptions}" SelectedItem="{Binding MachineUnits}"
                                      ToolTip="Units the amp works in (its MMEnable setting). Read from the amp when you connect." />

                            <TextBlock Grid.Row="9" Style="{StaticResource FieldLabel}" Text="Position offset" />
                            <TextBox Grid.Row="9" Grid.Column="1" Margin="0,4" Text="{Binding Serial.PositionOffset}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Find TigerStop" Command="{Binding FindTigerStopCommand}"
                                    ToolTip="Try every COM port and baud rate until a TigerStop answers" />
                            <Button Content="Connect" Command="{Binding ConnectCommand}" />
                            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" />
                        </StackPanel>

                        <TextBlock Text="Machine" FontWeight="Bold" Margin="0,16,0,4" />
                        <WrapPanel>
                            <Button Content="Home" Margin="0,0,6,6" Command="{Binding HomeCommand}" />
                            <Button Content="Read position" Margin="0,0,6,6" Command="{Binding QueryPositionCommand}" />
                            <Button Content="Stop" Margin="0,0,6,6" Command="{Binding StopCommand}" />
                            <Button Content="E-Stop" Margin="0,0,6,6" Foreground="White" Background="Firebrick"
                                    Command="{Binding EmergencyStopCommand}" />
                        </WrapPanel>

                        <TextBlock Text="Manual move" FontWeight="Bold" Margin="0,16,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="120" Margin="0,0,6,0" Text="{Binding ManualPosition, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Go" Command="{Binding MoveManualCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <DockPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="Serial log" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 TextChanged="Log_TextChanged" />
                    </DockPanel>
                </Grid>
</Window>
