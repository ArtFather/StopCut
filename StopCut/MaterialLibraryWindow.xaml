<Window x:Class="StopCut.MaterialLibraryWindow" Icon="/Assets/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Material library" Height="560" Width="1000" WindowStartupLocation="CenterOwner"
        Closed="Window_Closed">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="Gray">
            <Run Text="Lengths are in" /> <Run Text="{Binding UnitLabel, Mode=OneWay}" /><Run Text=". Edit any cell; changes are saved when you close this window. The letter starts each leftover ID of that material (A1, A2...)." />
        </TextBlock>
        <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8" BorderBrush="#C62828" BorderThickness="1" CornerRadius="4">
            <WrapPanel>
                <TextBlock Text="Safety spacer: parts shorter than" VerticalAlignment="Center" FontWeight="Bold" />
                <TextBox Text="{Binding SpacerMinPartMm}" Width="60" Margin="6,0" VerticalAlignment="Center" />
                <TextBlock Text="mm are cut with a spacer block of" VerticalAlignment="Center" FontWeight="Bold" />
                <TextBox Text="{Binding SpacerLengthMm}" Width="60" Margin="6,0" VerticalAlignment="Center" />
                <TextBlock Text="mm between the stop and the material (the stop moves out by that much). 0 turns it off."
                           VerticalAlignment="Center" Foreground="Gray" TextWrapping="Wrap" />
            </WrapPanel>
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Add material" Command="{Binding AddLibraryMaterialCommand}" />
            <Button Content="Delete material" Command="{Binding DeleteLibraryMaterialCommand}" />
            <Button Content="Save" Command="{Binding SaveCommand}" />
        </StackPanel>
        <DataGrid ItemsSource="{Binding Materials}" SelectedItem="{Binding LibrarySelection}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Letter" Binding="{Binding Letter}" Width="60" FontWeight="Bold" />
                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="110" />
                <DataGridTextColumn Header="Name / description" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Stock length" Binding="{Binding StockLength}" Width="100" />
                <DataGridTextColumn Header="Kerf" Binding="{Binding Kerf}" Width="70" />
                <DataGridTextColumn Header="End trim" Binding="{Binding TrimCut}" Width="80" />
                <DataGridTextColumn Header="Keep leftovers from" Binding="{Binding MinLeftover}" Width="140" />
                <DataGridTextColumn Header="Cut lines" Binding="{Binding Cuts.Count, Mode=OneWay}" Width="70" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
