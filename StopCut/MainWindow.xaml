<Window x:Class="StopCut.MainWindow" Icon="/Assets/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:StopCut.Controls"
        Title="StopCut - cut manager for TigerStop" Height="840" Width="1200"
        Closing="Window_Closing">

    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding ConnectionStatus}" />
            <Separator />
            <TextBlock Text="{Binding CurrentPosition, StringFormat='Position: {0}'}" />
            <Separator />
            <TextBlock Text="{Binding MachineStatus}" />
            <Separator />
            <TextBlock Text="StopCut is an independent product and is not affiliated with, sponsored, or endorsed by TigerStop, LLC." Foreground="Gray" />
        </StatusBar>


        <Menu DockPanel.Dock="Top" FontSize="14">
            <MenuItem Header="_Settings" SubmenuOpened="Settings_SubmenuOpened">
                <MenuItem Header="_Units">
                    <MenuItem x:Name="InchesItem" Header="_Inches" IsCheckable="True" Click="Inches_Click" />
                    <MenuItem x:Name="MillimetersItem" Header="_Millimeters" IsCheckable="True" Click="Millimeters_Click" />
                </MenuItem>
                <Separator />
                <MenuItem Header="_Material library..." Click="Library_Click" />
                <MenuItem Header="_Jobs folder..." Click="JobsFolder_Click" />
                <MenuItem Header="_Update from jobs folder" Command="{Binding UpdateFromJobsFolderCommand}" />
                <Separator />
                <MenuItem Header="TigerStop _connection..." Click="Connection_Click" />
                <MenuItem Header="_Terminal..." Click="Terminal_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_License agreement..." Click="Eula_Click" />
                <MenuItem Header="_About StopCut..." Click="About_Click" />
            </MenuItem>
        </Menu>

        <!-- Connect sits in the tab row, right of the tabs, to leave the height for the work. -->
        <Grid>
        <TabControl Margin="6">

            <!-- Manual cut: touch pad to send the stop to any length -->
            <TabItem Header="Manual cut" FontSize="16">
                <Grid Margin="12" TextElement.FontSize="16">
                    <Grid.Resources>
                        <Style x:Key="PadKey" TargetType="Button">
                            <Setter Property="FontSize" Value="34" />
                            <Setter Property="Margin" Value="5" />
                            <Setter Property="MinHeight" Value="72" />
                            <Setter Property="Command" Value="{Binding DataContext.PadKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Setter Property="CommandParameter" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
                        </Style>
                        <Style x:Key="PadAction" TargetType="Button">
                            <Setter Property="FontSize" Value="26" />
                            <Setter Property="Margin" Value="5" />
                            <Setter Property="MinHeight" Value="72" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="420" />
                    </Grid.ColumnDefinitions>

                    <!-- Readouts -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,20,0">
                    <StackPanel>
                        <TextBlock Text="Current position" Foreground="Gray" />
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding CurrentPosition}" FontSize="64" FontWeight="Bold" />
                        </Viewbox>
                        <TextBlock Text="{Binding MachineStatus}" FontSize="22" Margin="0,4,0,16" TextWrapping="Wrap" />

                        <TextBlock Text="Go to" Foreground="Gray" />
                        <Border BorderBrush="SteelBlue" BorderThickness="3" CornerRadius="6" Padding="12,4" Background="White">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding UnitLabel}" FontSize="36"
                                           VerticalAlignment="Bottom" Foreground="Gray" Margin="10,0,0,8" />
                                <TextBlock Text="{Binding PadEntry}" FontSize="64" FontWeight="Bold"
                                           TextAlignment="Right" MinHeight="86" />
                            </DockPanel>
                        </Border>

                        <TextBlock Text="{Binding ConnectionStatus}" Foreground="Gray" Margin="0,24,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    </ScrollViewer>

                    <!-- Number pad -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource PadKey}" Content="7" />
                        <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource PadKey}" Content="8" />
                        <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource PadKey}" Content="9" />
                        <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource PadKey}" Content="4" />
                        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource PadKey}" Content="5" />
                        <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource PadKey}" Content="6" />
                        <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource PadKey}" Content="1" />
                        <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource PadKey}" Content="2" />
                        <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource PadKey}" Content="3" />
                        <Button Grid.Row="3" Grid.Column="0" Style="{StaticResource PadKey}" Content="." />
                        <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource PadKey}" Content="0" />
                        <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource PadAction}" Content="⌫"
                                Command="{Binding PadBackspaceCommand}" />

                        <Button Grid.Row="4" Grid.Column="0" Style="{StaticResource PadAction}" Content="CLEAR"
                                Command="{Binding PadClearCommand}" />
                        <Button Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource PadAction}" Content="GO"
                                Background="ForestGreen" Foreground="White" FontSize="34"
                                Command="{Binding PadGoCommand}" />

                        <Button Grid.Row="5" Grid.Column="0" Style="{StaticResource PadAction}" Content="HOME"
                                Command="{Binding HomeCommand}" />
                        <Button Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource PadAction}" Content="STOP"
                                Background="Firebrick" Foreground="White" FontSize="34"
                                Command="{Binding StopCommand}" />
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Materials and cut lists -->
            <TabItem Header="Cut lists">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Job" FontWeight="Bold" Margin="0,0,0,4" />
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="Delete" Margin="6,0,0,0" Command="{Binding DeleteJobCommand}"
                                    ToolTip="Delete every cut line of this job" />
                            <ComboBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" />
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Materials" FontWeight="Bold" Margin="0,0,0,4" />
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Button Content="Import CSV..." Command="{Binding ImportCommand}" Margin="0,0,6,6" />
                            <Button Content="Update from folder" Command="{Binding UpdateFromJobsFolderCommand}" Margin="0,0,6,6"
                                    ToolTip="{Binding JobsFolder}" />
                        </WrapPanel>
                        <ListBox ItemsSource="{Binding JobMaterials}" SelectedItem="{Binding SelectedMaterial}"
                                 DisplayMemberPath="Name" />
                    </DockPanel>

                    <DockPanel Grid.Column="1" Margin="12,0,0,0">
                        <WrapPanel DockPanel.Dock="Top">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                            <TextBox Style="{StaticResource Field}" MinWidth="180"
                                     Text="{Binding SelectedMaterial.Name, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Stock length" />
                            <TextBox Style="{StaticResource Field}" Text="{Binding SelectedMaterial.StockLength}" />
                            <TextBlock Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Text="Kerf, end trim and leftovers: Settings &gt; Material library" />
                        </WrapPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Save" Command="{Binding SaveCommand}" />
                            <Button Content="Reset done counts" Command="{Binding ResetDoneCommand}" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Cut list (add a row at the bottom)" FontWeight="Bold" Margin="0,8,0,4" />
                        <DataGrid ItemsSource="{Binding SelectedMaterialCuts}" AutoGenerateColumns="False"
                                  CanUserAddRows="True" CanUserDeleteRows="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Job" Binding="{Binding Job}" Width="150" />
                                <DataGridTextColumn Header="Part / label" Binding="{Binding Label}" Width="*" />
                                <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="120" />
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="80" />
                                <DataGridTextColumn Header="Done" Binding="{Binding Done}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Cutting -->
            <TabItem Header="Cutting">
                <DockPanel Margin="8">
                    <!-- Full width along the bottom so every piece of the stick has room for its length. -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <TextBlock Text="{Binding CurrentStickTitle}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                        <c:StickView Stick="{Binding CurrentStick}" Height="70" />
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Width="440" Margin="12,0,0,0" Padding="16" Background="#EAF3FB"
                            BorderBrush="#1E6FB8" BorderThickness="2" CornerRadius="6">
                        <!-- Star rows share the panel height; the big numbers sit in Viewboxes so they shrink instead of clipping. -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="3*" MinHeight="30" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2*" MinHeight="20" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition>
                                    <RowDefinition.Style>
                                        <Style TargetType="RowDefinition">
                                            <Setter Property="Height" Value="3*" />
                                            <!-- Always leave room for the ID and the full message when a leftover is shown. -->
                                            <Setter Property="MinHeight" Value="170" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NewLeftoverTag}" Value="">
                                                    <Setter Property="Height" Value="0" />
                                                    <Setter Property="MinHeight" Value="0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </RowDefinition.Style>
                                </RowDefinition>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis">
                                <Run Text="NOW CUTTING" Foreground="#1E6FB8" /><Run Text="   " /><Run Text="{Binding CurrentMaterialName, Mode=OneWay}" />
                            </TextBlock>
                            <StackPanel Grid.Row="1">
                                <Border Margin="0,6,0,6" Padding="10,4" CornerRadius="6" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="SlateGray" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StickIsLeftover}" Value="True">
                                                    <Setter Property="Background" Value="#6A1B9A" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StickToUse}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Viewbox StretchDirection="DownOnly">
                                        <TextBlock Text="{Binding StickToUse}" FontSize="44" FontWeight="Bold" Foreground="White" />
                                    </Viewbox>
                                </Border>
                                <Border Margin="0,0,0,6" Padding="10,4" CornerRadius="6" HorizontalAlignment="Left" Background="#C62828">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SpacerWarning}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Viewbox StretchDirection="DownOnly">
                                        <TextBlock Text="{Binding SpacerWarning}" FontSize="40" FontWeight="Bold" Foreground="White" />
                                    </Viewbox>
                                </Border>
                            </StackPanel>
                            <Viewbox Grid.Row="2" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <TextBlock Text="{Binding NowCuttingSize}" FontSize="96" FontWeight="Bold" />
                            </Viewbox>
                            <TextBlock Grid.Row="3" Text="{Binding NowCuttingLabel}" FontSize="24" TextTrimming="CharacterEllipsis" Margin="0,0,0,12" />
                            <TextBlock Grid.Row="4" Text="LAST CUT" FontSize="16" FontWeight="Bold" Foreground="Gray" />
                            <Viewbox Grid.Row="5" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <TextBlock Text="{Binding LastCutSize}" FontSize="48" FontWeight="Bold" Foreground="DimGray" />
                            </Viewbox>
                            <TextBlock Grid.Row="6" Text="{Binding LastCutLabel}" FontSize="18" Foreground="DimGray" TextTrimming="CharacterEllipsis" />
                            <Border Grid.Row="7" Margin="0,12,0,0" Padding="10" Background="#E8F7E4" BorderBrush="ForestGreen" BorderThickness="2" CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NewLeftoverTag}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" MinHeight="50" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="NEW LEFTOVER - WRITE ON PIECE" FontSize="16" FontWeight="Bold" Foreground="DarkGreen" TextTrimming="CharacterEllipsis" />
                                    <Viewbox Grid.Row="1" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NewLeftoverTag}" FontSize="72" FontWeight="Bold" Foreground="DarkGreen" />
                                    </Viewbox>
                                    <TextBlock Grid.Row="2" Text="{Binding NewLeftoverText}" FontSize="16" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Job" />
                        <ComboBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" Width="180" Margin="0,0,12,0" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Material" />
                        <ComboBox ItemsSource="{Binding JobMaterials}" SelectedItem="{Binding SelectedMaterial}"
                                  DisplayMemberPath="Name" Width="260" Margin="0,0,12,0" />
                        <Button Content="Plan material" Command="{Binding BuildPlanCommand}" ToolTip="Plan the selected material only" />
                        <Button Content="Plan whole job" Command="{Binding BuildJobPlanCommand}" ToolTip="Plan every material of the selected job" />
                        <CheckBox Content="Send next position automatically" IsChecked="{Binding AutoSendNext}"
                                  VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding PlanSummary}" Margin="0,8" TextWrapping="Wrap" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Extra part on the fly: length" />
                        <TextBox Style="{StaticResource Field}" Text="{Binding ExtraLength, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="qty" />
                        <TextBox Style="{StaticResource Field}" Text="{Binding ExtraQuantity, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                        <Button Content="Add and cut next" Command="{Binding AddExtraPartCommand}"
                                ToolTip="Adds the part to this job and material and puts it first in the plan" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource BigButton}" Content="Send position" Command="{Binding SendPositionCommand}" />
                        <Button Style="{StaticResource BigButton}" Content="Cut done" Command="{Binding CutDoneCommand}" />
                        <Button Style="{StaticResource BigButton}" Content="Skip" Command="{Binding SkipCutCommand}" />
                        <Button Style="{StaticResource BigButton}" Content="Recut" Command="{Binding RecutCommand}"
                                ToolTip="The selected part came out bad: cut it again next" />
                        <Button Style="{StaticResource BigButton}" Content="Next material" Command="{Binding NextMaterialCommand}"
                                ToolTip="Go to the first cut of the next material; cuts left here stay in the plan" />
                        <Button Style="{StaticResource BigButton}" Content="Home" Command="{Binding HomeCommand}" />
                        <Button Style="{StaticResource BigButton}" Content="STOP" Foreground="White" Background="Firebrick"
                                Command="{Binding StopCommand}" />
                        <TextBlock VerticalAlignment="Center" FontSize="22" FontWeight="Bold"
                                   Text="{Binding SelectedCut.StopPosition, StringFormat='Stop at: {0:0.###}'}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Plan}" SelectedItem="{Binding SelectedCut}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Done">
                                        <Setter Property="Foreground" Value="Gray" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                        <Setter Property="Foreground" Value="Crimson" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Status}" Value="Pending" />
                                            <Condition Binding="{Binding NeedsSpacer}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="#FFEBEE" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Material" Binding="{Binding MaterialName}" Width="160" />
                            <DataGridTextColumn Header="Stick" Binding="{Binding BarNumber}" Width="60" />
                            <DataGridTextColumn Header="From" Binding="{Binding Source}" Width="160" />
                            <DataGridTextColumn Header="Part / label" Binding="{Binding Label}" Width="*" />
                            <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="120" />
                            <DataGridTextColumn Header="Spacer" Binding="{Binding SpacerNote}" Width="170" FontWeight="Bold" Foreground="#C62828" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                            <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="110" FontWeight="Bold" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Recuts -->
            <TabItem Header="Recuts">
                <DataGrid Margin="8" ItemsSource="{Binding Recuts}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="When" Binding="{Binding Time, StringFormat='yyyy-MM-dd HH:mm'}" Width="140" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="80" />
                        <DataGridTextColumn Header="Job" Binding="{Binding Job}" Width="160" />
                        <DataGridTextColumn Header="Material" Binding="{Binding Material}" Width="*" />
                        <DataGridTextColumn Header="Part" Binding="{Binding Label}" Width="160" />
                        <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Leftovers -->
            <TabItem Header="Leftovers">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Material" />
                        <ComboBox ItemsSource="{Binding Materials}" SelectedItem="{Binding NewLeftoverMaterial}"
                                  DisplayMemberPath="Name" Width="200" Margin="0,0,12,0" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Length" />
                        <TextBox Style="{StaticResource Field}" Text="{Binding NewLeftoverLength, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Add leftover" Command="{Binding AddLeftoverCommand}" />
                        <Button Content="Delete selected" Command="{Binding DeleteLeftoverCommand}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Leftovers}" SelectedItem="{Binding SelectedLeftover}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Tag}" Width="90" IsReadOnly="True" FontWeight="Bold" />
                            <DataGridTextColumn Header="Material" Binding="{Binding MaterialName}" Width="200" IsReadOnly="True" />
                            <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="120" />
                            <DataGridTextColumn Header="Added" Binding="{Binding Created, StringFormat=g}" Width="150" IsReadOnly="True" />
                            <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0" Orientation="Horizontal">
            <TextBlock Text="{Binding ConnectionStatus}" VerticalAlignment="Center" Margin="0,0,8,0" MaxWidth="420"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding ConnectionStatus}" />
            <Button Content="Connect" FontSize="14" Padding="14,2" Margin="0,0,4,0" Command="{Binding ConnectCommand}" />
            <Button Content="Disconnect" FontSize="14" Padding="14,2" Margin="0" Command="{Binding DisconnectCommand}" />
        </StackPanel>
        </Grid>
    </DockPanel>
</Window>
