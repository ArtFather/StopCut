<Window x:Class="StopCut.EulaWindow" Icon="/Assets/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StopCut - License agreement" Height="640" Width="760" WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap" FontWeight="Bold"
                   Text="This software moves machinery. Read and accept these terms before using it." />
        <StackPanel x:Name="AcceptPanel" DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <CheckBox x:Name="AgreeBox" Margin="0,0,0,8" FontSize="14"
                      Content="I have read and agree to the license agreement, and I accept full responsibility for safe machine operation." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Accept" IsDefault="True" Click="Accept_Click"
                        IsEnabled="{Binding IsChecked, ElementName=AgreeBox}" />
                <Button Content="Decline and exit" IsCancel="True" Click="Decline_Click" />
            </StackPanel>
        </StackPanel>
        <Button x:Name="CloseButton" DockPanel.Dock="Bottom" Content="Close" HorizontalAlignment="Right"
                Margin="0,8,0,0" IsCancel="True" Visibility="Collapsed" Click="Decline_Click" />
        <TextBox x:Name="TermsText" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13"
                 VerticalScrollBarVisibility="Auto" />
    </DockPanel>
</Window>
